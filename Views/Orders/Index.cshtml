@using CCMobile.Localization
@model IEnumerable<CCMobile.Models.Order>
@using System.Globalization
@using CCMobile.Services
@{ ViewData["Title"] = StoreText.T("Đơn hàng của tôi"); var culture = CultureInfo.GetCultureInfo("vi-VN"); }
<div class="py-4">
    <h1 class="h3">@StoreText.T("Đơn hàng của tôi")</h1>
    @if (!Model.Any()) { <p class="my-4">@StoreText.T("Bạn chưa có đơn hàng nào.")</p> }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>@StoreText.T("Mã đơn")</th><th>@StoreText.T("Thời gian (Việt Nam)")</th><th>@StoreText.T("Tổng tiền")</th><th>@StoreText.T("Trạng thái")</th><th></th></tr></thead>
                <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td>@order.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@order.Total.ToString("N0", culture) ₫</td>
                        <td>@OrderWorkflow.Label(order.Status)</td>
                        <td><a asp-action="Details" asp-route-id="@order.Id">@StoreText.T("Xem đơn")</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-dark">@StoreText.T("Tiếp tục mua sắm")</a>
</div>
