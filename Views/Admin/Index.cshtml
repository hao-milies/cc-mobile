@{
    ViewData["Title"] = "Quản trị cửa hàng";
}

<div class="py-5">
    <p class="small fw-bold">CC MOBILE / QUẢN TRỊ</p>

    <h1 class="h3">Quản trị cửa hàng</h1>

    <p class="text-muted">
        Bạn đã đăng nhập bằng tài khoản có quyền quản trị.
    </p>

    <div class="p-4 border rounded-3"
