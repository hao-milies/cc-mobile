@{
    ViewData["Title"] = "Tổng quan quản lý";
}
<div class="py-5">
    <p class="small fw-bold">CC MOBILE / QUẢN TRỊ</p>
    <h1 class="h3">Tổng quan quản lý</h1>
    <p class="text-muted mb-4">Truy cập các công cụ quản lý sản phẩm, tồn kho và xử lý đơn hàng.</p>
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <section class="border rounded-3 p-4 h-100" style="background: #f7f3e8;">
                <h2 class="h5">Đơn hàng</h2>
                <p>Theo dõi trạng thái, xử lý đơn hàng và xét duyệt yêu cầu hủy.</p>
                <a asp-controller="AdminOrders" asp-action="Index" class="btn btn-warning fw-semibold"><svg class="cc-icon " viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 3h6v4H9zM9 12h6M9 16h6"/></svg> Quản lý đơn hàng</a>
            </section>
        </div>

        <div class="col-12 col-md-4">
            <section class="border rounded-3 p-4 h-100" style="background: #f7f3e8;">
                <h2 class="h5">Sản phẩm</h2>
                <p>Thông tin, giá bán, tồn kho, thông số và hình ảnh.</p>
                <a asp-controller="AdminProducts" asp-action="Index"
                   class="btn btn-warning fw-semibold"><svg class="cc-icon " viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M10 18h4"/></svg> Quản lý sản phẩm</a>
            </section>
        </div>
        <div class="col-12 col-md-4">
            <section class="border rounded-3 p-4 h-100" style="background: #f7f3e8;">
                <h2 class="h5">Danh mục</h2>
                <p>Phân loại điện thoại, tai nghe, sạc và phụ kiện.</p>
                <a asp-controller="AdminCategories" asp-action="Index"
                   class="btn btn-warning fw-semibold"><svg class="cc-icon " viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg> Quản lý danh mục</a>
            </section>
        </div>
        <div class="col-12 col-md-4">
            <section class="border rounded-3 p-4 h-100" style="background: #f7f3e8;">
                <h2 class="h5">Thương hiệu</h2>
                <p>Cập nhật thương hiệu để phân loại và tìm kiếm sản phẩm.</p>
                <a asp-controller="AdminBrands" asp-action="Index"
                   class="btn btn-warning fw-semibold"><svg class="cc-icon " viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 3h7l11 11-7 7L3 10z"/><circle cx="7" cy="7" r="1"/></svg> Quản lý thương hiệu</a>
            </section>
        </div>
    </div>
</div>
