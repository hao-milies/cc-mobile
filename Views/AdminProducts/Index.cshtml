@model IEnumerable<CCMobile.Models.Product>
@using System.Globalization
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}
<div class="py-4">
    <a asp-controller="Admin" asp-action="Index" class="text-dark">← Trang quản trị</a>
    <h1 class="h3 mt-4">Quản lý sản phẩm</h1>
    <a asp-action="Create" class="btn btn-warning fw-semibold my-3">+ Thêm sản phẩm</a>
    <p class="text-muted">Có @Model.Count() sản phẩm trong cửa hàng.</p>
    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    @if (TempData["VisibilityError"] is string visibilityError)
    {
        <div class="alert alert-warning" role="alert">@visibilityError</div>
    }
    <p class="small text-muted">Ngừng bán sẽ gỡ sản phẩm khỏi cửa hàng, giữ nguyên dữ liệu và tồn kho. Hết hàng là trạng thái tồn kho riêng.</p>
    @if (!Model.Any())
    {
        <div class="alert alert-light border">Chưa có sản phẩm.</div>
    }
    else
    {
        <div class="table-responsive border rounded">
            <table class="table table-hover align-middle mb-0">
                <caption class="visually-hidden">Danh sách sản phẩm dành cho quản trị viên</caption>
                <thead class="table-light">
                    <tr>
                        <th scope="col">Sản phẩm</th>
                        <th scope="col">Thương hiệu</th>
                        <th scope="col">Danh mục</th>
                        <th scope="col" class="text-end">Giá bán</th>
                        <th scope="col" class="text-end">Tồn kho</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@product.Name</div>
                                <div class="small text-muted">@product.Sku</div>
                            </td>
                            <td>@product.Brand.Name</td>
                            <td>@product.Category.Name</td>
                            <td class="text-end text-nowrap"><strong class="@(product.HasDiscount ? "text-danger" : "")">@product.EffectivePrice.ToString("N0", culture) ₫</strong>
                                @if (product.HasDiscount)
                                { <small class="d-block text-muted"><del>@product.Price.ToString("N0", culture) ₫</del> · @(product.DiscountPercent > 0 ? "-" + product.DiscountPercent.ToString("0.#", culture) + "%" : "Ưu đãi")</small> }</td>
                            <td class="text-end">@product.StockQuantity</td>
                            <td>
                                @if (product.IsActive)
                                {
                                    <span class="badge bg-success">Đang bán</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã ngừng bán</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <form asp-action="SetVisibility" method="post"
                                          onsubmit="return confirm(this.dataset.confirm)"
                                          data-confirm="@(product.IsActive ? "Ngừng bán sản phẩm này? Sản phẩm sẽ được gỡ khỏi cửa hàng; đơn hàng cũ vẫn giữ nguyên." : "Hiện bán lại sản phẩm này trên cửa hàng?")">
                                        <input type="hidden" name="id" value="@product.Id" />
                                        <input type="hidden" name="expectedActive" value="@product.IsActive.ToString().ToLowerInvariant()" />
                                        <button type="submit" class="btn btn-sm @(product.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                aria-label="@(product.IsActive ? "Ngừng bán " + product.Name : "Hiện bán lại " + product.Name)">
                                            @(product.IsActive ? "Ngừng bán" : "Hiện bán lại")
                                        </button>
                                    </form>
                                    <a asp-action="Edit" asp-route-id="@product.Id"
                                       class="btn btn-sm btn-outline-dark">Sửa</a>
                                    <a asp-action="Images" asp-route-id="@product.Id"
                                       class="btn btn-sm btn-outline-dark">Quản lý ảnh</a>
                                    @if (product.IsActive)
                                    {
                                        <a asp-controller="Products" asp-action="Details"
                                           asp-route-id="@product.Id"
                                           class="btn btn-sm btn-outline-dark">Xem</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
