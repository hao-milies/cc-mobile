@using CCMobile.Localization
@{ ViewData["Title"] = StoreText.T("Thông tin quyền riêng tư"); }
<article class="cc-privacy">
    <p class="cc-kicker">@StoreText.T("CC MOBILE / THÔNG TIN WEBSITE")</p>
    <h1>@StoreText.T("Thông tin quyền riêng tư")</h1>
    <p class="lead">@StoreText.T("Những thông tin bạn cung cấp khi sử dụng tài khoản và đặt hàng tại CC Mobile.")</p>
    <h2>@StoreText.T("Thông tin tài khoản và đơn hàng")</h2>
    <p>@StoreText.T("Website lưu thông tin tài khoản và lịch sử đơn hàng. Khi đặt hàng, bạn cung cấp tên người nhận, số điện thoại, địa chỉ giao hàng và ghi chú nếu có.")</p>
    <h2>@StoreText.T("Mục đích sử dụng")</h2>
    <p>@StoreText.T("Thông tin được sử dụng để đăng nhập, tạo và theo dõi đơn hàng. Quản trị viên sử dụng thông tin đơn hàng để xử lý đơn và yêu cầu hủy.")</p>
    <h2>@StoreText.T("Cookie và phiên làm việc")</h2>
    <p>@StoreText.T("Website sử dụng cookie phục vụ đăng nhập và duy trì phiên làm việc, bao gồm giỏ hàng. Xóa cookie có thể khiến bạn cần đăng nhập lại hoặc làm mất giỏ hàng hiện tại.")</p>
    <h2>@StoreText.T("Lưu ý về phiên bản hiện tại")</h2>
    <p>@StoreText.T("CC Mobile hiện là dự án học tập và trình diễn chức năng bán hàng. Khi dùng thử, vui lòng sử dụng thông tin mẫu thay cho dữ liệu cá nhân thật.")</p>
    <a asp-controller="Products" asp-action="Index" class="btn btn-warning">@StoreText.T("Xem sản phẩm")</a>
</article>
