@model IEnumerable<CCMobile.ViewModels.LookupListItemViewModel>
@{
    ViewData["Title"] = "Quản lý danh mục";
}
<div class="py-4">
    <a asp-controller="Admin" asp-action="Index" class="text-dark">← Trang quản trị</a>
    <h1 class="h3 mt-4">Quản lý danh mục</h1>
    <a asp-action="Create" class="btn btn-warning fw-semibold my-3">+ Thêm danh mục</a>
    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    @if (!Model.Any())
    {
        <p class="text-muted">Chưa có danh mục.</p>
    }
    else
    {
        <div class="table-responsive border rounded">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">Danh sách danh mục</caption>
                <thead class="table-light">
                    <tr>
                        <th scope="col">Tên</th>
                        <th scope="col">Mô tả</th>
                        <th scope="col">Số sản phẩm</th>
                        <th scope="col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td style="max-width: 400px; overflow-wrap: anywhere;">@item.Description</td>
                            <td>@item.ProductCount</td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-dark">Sửa</a>
                                    @if (item.ProductCount == 0)
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                              onsubmit="return confirm('Xóa danh mục này?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="small text-muted align-self-center">Đang được sử dụng</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small mt-3">Số sản phẩm bao gồm cả sản phẩm đang ẩn.</p>
    }
</div>
