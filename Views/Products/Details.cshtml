@using CCMobile.Localization
<link rel="stylesheet" href="~/css/cc-editor.css" asp-append-version="true" />
@model CCMobile.Models.Product
@using System.Globalization

@{
    ViewData["Title"] = Model.Name;
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var images = Model.Images
        .OrderByDescending(i => i.IsPrimary)
        .ThenBy(i => i.DisplayOrder)
        .ToList();

    var mainImage = images.FirstOrDefault();
    var specs = Model.PhoneSpecification;
}

<div class="cc-details">
    <nav aria-label="@StoreText.T("Đường dẫn")" class="mb-4">
        <a asp-controller="Products" asp-action="Index"
           class="cc-back">
            ← @StoreText.T("Điện thoại và phụ kiện")
        </a>
    </nav>

    <div class="row g-4 g-lg-5 align-items-start">
        <div class="col-lg-7">
            <div class="cc-gallery">
                @if (mainImage != null)
                {
                    <img id="product-main-image"
                         src="@Url.Content(mainImage.ImageUrl)"
                         alt="@(mainImage.AltText ?? Model.Name)"
                         class="cc-main-image" />
                }
                else
                {
                    <div class="cc-image-placeholder">
                        @StoreText.T("Ảnh sản phẩm đang được cập nhật")
                    </div>
                }
            </div>

            @if (images.Count > 1)
            {
                <div class="cc-thumbnails mt-3"
                     aria-label="@StoreText.T("Ảnh sản phẩm")">
                    @foreach (var image in images)
                    {
                        <button type="button"
                                class="cc-thumbnail"
                                data-image="@Url.Content(image.ImageUrl)"
                                data-alt="@(image.AltText ?? Model.Name)"
                                aria-label="@StoreText.T("Xem ảnh") @(image.AltText ?? Model.Name)">
                            <img src="@Url.Content(image.ImageUrl)"
                                 alt=""
                                 loading="lazy" />
                        </button>
                    }
                </div>
            }
        </div>

        <div class="col-lg-5">
            <p class="cc-eyebrow">@Model.Brand.Name</p>
            <h1 class="cc-product-title">@Model.Name</h1>
            <p class="text-muted small">@StoreText.T("Mã sản phẩm:") @Model.Sku</p>

            <p class="cc-price">
                @Model.EffectivePrice.ToString("N0", culture) ₫
            </p>

            @if (Model.HasDiscount)
            {
                <div class="cc-detail-discount mb-3">
                    <del>@Model.Price.ToString("N0", culture) ₫</del>
                    <span class="cc-sale-pill">@(Model.DiscountPercent > 0 ? StoreText.T("Giảm ") + Model.DiscountPercent.ToString("0.#", culture) + "%" : StoreText.T("Giá khuyến mại"))</span>
                    <p class="small mb-0 mt-2">@StoreText.T("Tiết kiệm") @((Model.Price - Model.EffectivePrice).ToString("N0", culture)) ₫</p>
                </div>
            }
            @if (Model.StockQuantity > 0)
            {
                <span class="cc-stock">@StoreText.T("Còn hàng")</span>
            }
            else
            {
                <span class="cc-stock cc-stock-out">@StoreText.T("Tạm hết hàng")</span>
            }

            @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
            {
                <p class="cc-summary">@Model.ShortDescription</p>
            }

            <dl class="cc-facts">
                <div>
                    <dt>@StoreText.T("Danh mục")</dt>
                    <dd>@Model.Category.Name</dd>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Color))
                {
                    <div>
                        <dt>@StoreText.T("Màu sắc")</dt>
                        <dd>@Model.Color</dd>
                    </div>
                }

                <div>
                    <dt>@StoreText.T("Bảo hành")</dt>
                    <dd>
                        @(Model.WarrantyMonths > 0
                            ? StoreText.F("{0} tháng", Model.WarrantyMonths)
                            : StoreText.T("Không áp dụng"))
                    </dd>
                </div>
            </dl>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="AdminProducts" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning my-4">@StoreText.T("Chỉnh sửa sản phẩm")</a>
            }
            else
            {
            @if (Model.StockQuantity > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" class="my-4">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <label for="cart-quantity" class="form-label">@StoreText.T("Số lượng")</label>
                    <div class="d-flex gap-3">
                        <input id="cart-quantity" name="quantity" type="number" value="1"
                               min="1" max="@Math.Min(Model.StockQuantity, 99)" step="1" required
                               class="form-control" style="width: 90px;" />
                        <button type="submit" class="btn btn-warning fw-semibold flex-grow-1">
                            @StoreText.T("Thêm vào giỏ hàng")
                        </button>
                    </div>
                </form>
            }
            else
            {
                <button type="button" class="btn btn-secondary w-100 my-4" disabled>@StoreText.T("Tạm hết hàng")</button>
            }
            }

            @if (specs != null)
            {
                <a href="#specifications" class="cc-yellow-button">
                    @StoreText.T("Xem thông số kỹ thuật") ↓
                </a>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <section class="cc-section">
            <h2 class="cc-section-title">@StoreText.T("Về sản phẩm")</h2>
            <div class="cc-description cc-rich-description">@CCMobile.Infrastructure.ProductDescription.Render(Model.Description)</div>
        </section>
    }

    @if (specs != null)
    {
        <section id="specifications" class="cc-section">
            <h2 class="cc-section-title">@StoreText.T("Thông số kỹ thuật")</h2>

            <div class="table-responsive">
                <table class="table cc-spec-table mb-0">
                    <caption class="visually-hidden">
                        @StoreText.F("Thông số kỹ thuật của {0}", Model.Name)
                    </caption>
                    <tbody>
                        <tr>
                            <th scope="row">@StoreText.T("Chip xử lý")</th>
                            <td>@specs.Chipset</td>
                        </tr>
                        <tr>
                            <th scope="row">RAM</th>
                            <td>@specs.RamGb GB</td>
                        </tr>
                        <tr>
                            <th scope="row">@StoreText.T("Bộ nhớ")</th>
                            <td>@specs.StorageGb GB</td>
                        </tr>
                        <tr>
                            <th scope="row">@StoreText.T("Màn hình")</th>
                            <td>
                                @specs.ScreenSizeInches.ToString("0.#", culture) inch
                            </td>
                        </tr>
                        <tr>
                            <th scope="row">@StoreText.T("Độ phân giải")</th>
                            <td>@(specs.ScreenResolution ?? StoreText.T("Đang cập nhật"))</td>
                        </tr>
                        <tr>
                            <th scope="row">@StoreText.T("Tấm nền")</th>
                            <td>@(specs.PanelType ?? StoreText.T("Đang cập nhật"))</td>
                        </tr>
                        <tr>
                            <th scope="row">@StoreText.T("Tần số quét")</th>
                            <td>@(specs.RefreshRateHz?.ToString() is string hz ? $"{hz} Hz" : StoreText.T("Đang cập nhật"))</td>
                        </tr>
                        <tr>
                            <th scope="row">@StoreText.T("Camera sau")</th>
                            <td>@(specs.RearCamera ?? StoreText.T("Đang cập nhật"))</td>
                        </tr>
                        <tr>
                            <th scope="row">@StoreText.T("Camera trước")</th>
                            <td>@(specs.FrontCamera ?? StoreText.T("Đang cập nhật"))</td>
                        </tr>
                        <tr>
                            <th scope="row">@StoreText.T("Dung lượng pin")</th>
                            <td>@(specs.BatteryMah.HasValue ? $"{specs.BatteryMah} mAh" : StoreText.T("Đang cập nhật"))</td>
                        </tr>
                        <tr>
                            <th scope="row">@StoreText.T("Công suất sạc")</th>
                            <td>@(specs.ChargingWatts.HasValue ? $"{specs.ChargingWatts} W" : StoreText.T("Đang cập nhật"))</td>
                        </tr>
                        <tr>
                            <th scope="row">@StoreText.T("Hệ điều hành")</th>
                            <td>@(specs.OperatingSystem ?? StoreText.T("Đang cập nhật"))</td>
                        </tr>
                        <tr>
                            <th scope="row">@StoreText.T("Khối lượng")</th>
                            <td>@(specs.WeightGrams.HasValue ? $"{specs.WeightGrams.Value.ToString("0.#", culture)} g" : StoreText.T("Đang cập nhật"))</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll(".cc-thumbnail").forEach(button => {
            button.addEventListener("click", () => {
                const mainImage = document.getElementById("product-main-image");

                if (mainImage) {
                    mainImage.src = button.dataset.image;
                    mainImage.alt = button.dataset.alt;
                }
            });
        });
    </script>
}