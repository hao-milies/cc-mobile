@model IEnumerable<CCMobile.Models.Product>
@using System.Globalization

@{
    ViewData["Title"] = "Điện thoại và phụ kiện";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var search = ViewData["Search"] as string;
}
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">
        @successMessage
    </div>
}

<div class="py-4">
    <div class="mb-5">
        <h1 class="display-5 fw-bold">Điện thoại và phụ kiện</h1>
        <p class="lead text-muted">
            Khám phá điện thoại và phụ kiện phù hợp với bạn.
        </p>
    </div>

    <form asp-controller="Products"
          asp-action="Index"
          method="get"
          class="mb-4">

        <div class="row g-3 align-items-end">
            <div class="col-12 col-lg-5">
                <label for="product-search" class="form-label">
                    Tìm sản phẩm
                </label>

                <input id="product-search"
                       name="search"
                       type="search"
                       value="@search"
                       class="form-control"
                       placeholder="Tên điện thoại hoặc mã sản phẩm..." />
            </div>

            <div class="col-6 col-lg-3">
                <label for="brand-filter" class="form-label">
                    Thương hiệu
                </label>

                <select id="brand-filter"
                        name="brandId"
                        asp-items="ViewBag.BrandOptions"
                        class="form-select">
                    <option value="">Tất cả thương hiệu</option>
                </select>
            </div>

            <div class="col-6 col-lg-2">
                <label for="sort-filter" class="form-label">
                    Sắp xếp
                </label>

                <select id="sort-filter"
                        name="sort"
                        asp-items="ViewBag.SortOptions"
                        class="form-select">
                </select>
            </div>

            <div class="col-12 col-lg-2">
                <button type="submit"
                        class="btn btn-warning w-100 text-dark fw-semibold">
                    Áp dụng
                </button>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-muted">
                @Model.Count() sản phẩm
            </span>

            <a asp-controller="Products"
               asp-action="Index"
               class="text-dark">
                Xóa bộ lọc
            </a>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(search))
    {
        <p class="text-muted">
            Tìm thấy <strong>@Model.Count()</strong>
            sản phẩm cho “@search”.
        </p>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-light border">
            Không có sản phẩm phù hợp.
            Hãy thử từ khóa khác hoặc xóa bộ lọc.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var product in Model)
            {
                var coverImage = product.Images
       .OrderByDescending(i => i.IsPrimary)
       .ThenBy(i => i.DisplayOrder)
       .FirstOrDefault();

                
                <div class="col-12 col-sm-6 col-lg-4">
                    <article class="card h-100 border-0 shadow-sm">
                        <a asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@product.Id"
                           aria-label="Xem chi tiết @product.Name"
                           class="text-decoration-none">

                            <div class="bg-white d-flex align-items-center
                                justify-content-center rounded-top"
                                 style="height: 260px;">

                                @if (coverImage != null)
                                {
                                    <img src="@Url.Content(coverImage.ImageUrl)"
                                         alt="@(coverImage.AltText ?? product.Name)"
                                         loading="lazy"
                                         style="width: 100%; height: 100%;
                                    object-fit: contain; padding: 20px;" />
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Chưa có ảnh sản phẩm
                                    </span>
                                }
                            </div>
                        </a>

                        <div class="card-body p-4">
                            <p class="text-muted small mb-2">
                                @product.Brand.Name
                            </p>

                            <h2 class="h5">
                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="text-decoration-none text-dark">
                                    @product.Name
                                </a>
                            </h2>

                            <p class="text-muted small">
                                @product.ShortDescription
                            </p>

                            <p class="fs-5 fw-bold mb-2">
                                @product.Price.ToString("N0", culture) ₫
                            </p>

                            @if (product.StockQuantity > 0)
                            {
                                <span class="small text-success">
                                    Còn hàng
                                </span>
                            }
                            else
                            {
                                <span class="small text-secondary">
                                    Tạm hết hàng
                                </span>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>