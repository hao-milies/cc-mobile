@model CCMobile.ViewModels.CartViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Giỏ hàng";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}
<div class="py-4">
    <h1 class="h3">Giỏ hàng</h1>
    @if (TempData["CartSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["CartError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    @if (Model.Notice != null)
    {
        <div class="alert alert-warning" role="status">@Model.Notice</div>
    }
    @if (!Model.Items.Any())
    {
        <p class="text-muted my-4">Giỏ hàng chưa có sản phẩm.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-warning">Khám phá sản phẩm</a>
    }
    else
    {
        <p class="text-muted">@Model.Items.Count loại sản phẩm · @Model.TotalQuantity sản phẩm</p>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr>
                    <th scope="col">Sản phẩm</th>
                    <th scope="col">Đơn giá</th>
                    <th scope="col">Số lượng</th>
                    <th scope="col">Thành tiền</th>
                    <th scope="col">Thao tác</th>
                </tr></thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId"
                               class="d-flex gap-3 align-items-center text-dark text-decoration-none">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@Url.Content(item.ImageUrl)" alt="" width="72" height="72"
                                         style="object-fit: contain;" />
                                }
                                <span>@item.Name</span>
                            </a>
                        </td>
                        <td class="text-nowrap"><strong class="text-danger">@item.Price.ToString("N0", culture) ₫</strong>
                            @if (item.OriginalPrice > item.Price)
                            { <del class="d-block small text-muted">@item.OriginalPrice.ToString("N0", culture) ₫</del> }
                        </td>
                        <td>
                            <form asp-action="Update" method="post" class="d-flex gap-2">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="number" name="quantity" value="@item.Quantity"
                                       min="1" max="@item.MaxQuantity" step="1" required
                                       aria-label="Số lượng @item.Name"
                                       class="form-control" style="width: 85px;" />
                                <button type="submit" class="btn btn-sm btn-outline-dark text-nowrap">Cập nhật</button>
                            </form>
                        </td>
                        <td class="fw-semibold text-nowrap">@item.Subtotal.ToString("N0", culture) ₫</td>
                        <td>
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        aria-label="Xóa @item.Name khỏi giỏ">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="text-end my-4">
            <p class="fs-5 fw-semibold">Tạm tính: @Model.Total.ToString("N0", culture) ₫</p>
            <p class="text-muted small">Giá và tồn kho có thể thay đổi. Thêm vào giỏ chưa giữ hàng.</p>
        </div>
        <div class="d-flex flex-wrap gap-3">
            <a asp-controller="Orders" asp-action="Checkout" class="btn btn-dark">Tiến hành đặt hàng</a>
            <a asp-controller="Products" asp-action="Index" class="btn btn-warning">Tiếp tục mua sắm</a>
            <form asp-action="Clear" method="post" onsubmit="return confirm('Xóa tất cả sản phẩm khỏi giỏ?');">
                <button type="submit" class="btn btn-outline-danger">Xóa giỏ hàng</button>
            </form>
        </div>
    }
</div>
